# API Key Authentication (simple, no OAuth required)
# OAuth 2.1 Authentication (for web interface with team collaboration)
# MCP_OAUTH_ENABLED=false
# Preset OAuth client credentials (stable ID and Secret)
# MCP_OAUTH_PRESET_CLIENT_ID=your-stable-client-id
# MCP_OAUTH_PRESET_CLIENT_SECRET=your-stable-client-secret
# OAuth Storage Backend (memory|sqlite)
MCP_OAUTH_STORAGE_BACKEND=memory
MCP_OAUTH_SQLITE_PATH=./data/oauth.db

# OAuth Token Expiration (minutes)
# MCP_OAUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440    # Max: 24 hours (1-1440 min)
# MCP_OAUTH_AUTHORIZATION_CODE_EXPIRE_MINUTES=60  # Max: 60 minutes (1-60 min)